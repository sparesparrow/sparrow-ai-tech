---

<CyberpunkLayout title={title}>
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
    <!-- Language Toggle -->
    <div class="fixed right-4 top-4 z-50">
      <LanguageToggle client:load />
    </div>

    <!-- Hero Section -->
    <section class="relative overflow-hidden pb-32 pt-20">
      <div class="bg-grid-pattern absolute inset-0 opacity-10"></div>
      <div class="container relative z-10 mx-auto px-6">
        <div class="text-center">
          <h1
            class="mb-6 bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-4xl font-bold text-transparent md:text-6xl lg:text-7xl"
          >
            Vojtěch Špaček
          </h1>
          <div class="mb-8 font-mono text-xl text-cyan-300 md:text-2xl">
            | {t?.hero} |
          </div>
          <div class="mx-auto mb-12 grid max-w-5xl items-center gap-8 md:grid-cols-[1fr,auto]">
            <p class="text-lg text-slate-300 md:text-xl">{t?.subtitle}</p>
            <figure
              class="justify-self-center rounded-xl border border-cyan-500/30 bg-slate-800/40 p-3 backdrop-blur-sm"
            >
              <img
                src={`${import.meta.env.BASE_URL}/assets/ai-hero.svg`}
                alt="AI hero illustration"
                class="h-24 w-auto md:h-28 lg:h-32"
                loading="lazy"
              />
            </figure>
          </div>

          <!-- Stats Grid -->
          <div class="mx-auto mb-16 grid max-w-4xl grid-cols-2 gap-6 md:grid-cols-4">
            <div class="rounded-lg border border-cyan-500/30 bg-slate-800/50 p-4 backdrop-blur-sm">
              <div class="text-2xl font-bold text-cyan-400">15+</div>
              <div class="text-sm text-slate-300">MCP Projects</div>
            </div>
            <div class="rounded-lg border border-purple-500/30 bg-slate-800/50 p-4 backdrop-blur-sm">
              <div class="text-2xl font-bold text-purple-400">98%</div>
              <div class="text-sm text-slate-300">↑ Test Coverage</div>
            </div>
            <div class="rounded-lg border border-green-500/30 bg-slate-800/50 p-4 backdrop-blur-sm">
              <div class="text-2xl font-bold text-green-400">3x</div>
              <div class="text-sm text-slate-300">% Faster Response</div>
            </div>
            <div class="rounded-lg border border-orange-500/30 bg-slate-800/50 p-4 backdrop-blur-sm">
              <div class="text-2xl font-bold text-orange-400">-85%</div>
              <div class="text-sm text-slate-300">% ↓ Bugs</div>
            </div>
          </div>

          <div class="mb-16 flex flex-col justify-center gap-4 sm:flex-row">
            <a
              href="/sparrow-ai-tech/mermaid-editor"
              class="rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-8 py-3 font-medium text-white transition-all duration-300 hover:from-cyan-400 hover:to-purple-400"
            >
              {t?.explore}
            </a>
            <a
              href="/sparrow-ai-tech/cv.pdf"
              class="rounded-lg border border-cyan-500/50 px-8 py-3 font-medium text-cyan-400 transition-all duration-300 hover:bg-cyan-500/10"
            >
              Download CV
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Expertise -->
    <section class="py-20">
      <div class="container mx-auto px-6">
        <h2 class="mb-16 text-center text-3xl font-bold text-white md:text-4xl">Core Expertise</h2>

        <div class="grid gap-8 md:grid-cols-3">
          <!-- MCP Development -->
          <div
            class="rounded-lg border border-cyan-500/30 bg-slate-800/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-cyan-400/50"
