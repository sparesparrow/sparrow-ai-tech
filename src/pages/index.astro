              >
              <span class="rounded-full border border-cyan-500/30 bg-cyan-500/20 px-3 py-1 text-sm text-cyan-300"
                >Kubernetes</span
              >
              <span class="rounded-full border border-green-500/30 bg-green-500/20 px-3 py-1 text-sm text-green-300"
                >CI/CD</span
              >
            </div>
          </div>

          <!-- AWS Cloud Services -->
          <div
            class="rounded-lg border border-orange-500/30 bg-slate-800/30 p-6 backdrop-blur-sm transition-all duration-300 hover:border-orange-400/50"
