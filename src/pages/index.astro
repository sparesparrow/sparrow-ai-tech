---
import CyberpunkLayout from '../layouts/CyberpunkLayout.astro';
import RepoGallery from '../components/RepoGallery.jsx';

import '../css/main.css';
import '../styles/home.css';

export interface Props {
  title?: string;
}

const { title = 'Vojtěch Špaček — AI/LLM & Embedded Engineer' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const links = {
  email: 'mailto:sparesparrow@protonmail.ch',
  github: 'https://github.com/sparesparrow',
  linkedin: 'https://www.linkedin.com/in/sparesparrow',
  x: 'https://x.com/spare23sparrow',
  calendly: 'https://calendly.com/dallheimal',
  cv: `${base}cv/Vojtech_Spacek_CV.pdf`,
};

const stats = [
  { value: '10 yrs', label: 'Aerospace, scientific instruments, network security', color: 'text-cyan-400', border: 'border-cyan-500/30' },
  { value: '100+ ★', label: 'MCP-Prompts, a Model Context Protocol server on GitHub', color: 'text-purple-400', border: 'border-purple-500/30' },
  { value: '~290', label: 'Tests generated from a 270+ transition state-machine catalogue', color: 'text-green-400', border: 'border-green-500/30' },
  { value: '25+', label: 'Firmware & harness defects investigated with repro scripts', color: 'text-orange-400', border: 'border-orange-500/30' },
];

const expertise = [
  {
    badge: 'MCP',
    title: 'AI/LLM Integration & Agentic Tooling',
    color: 'cyan',
    text: 'Agentic harnesses of specialised agents, skills, prompt workflows, policy hooks and Model Context Protocol servers — adopted as a daily part of a safety-critical delivery workflow.',
    tags: ['Model Context Protocol', 'Prompt engineering', 'RAG & tool calling', 'Multi-agent workflows'],
  },
  {
    badge: 'HIL',
    title: 'Safety-Critical Verification',
    color: 'purple',
    text: 'Hardware-in-the-loop benches and state-machine conformance testing for UL/CSA-certified products, with end-to-end requirement traceability and test evidence.',
    tags: ['pyvisa / USBTMC / SCPI', 'CAN', 'Modbus', 'Traceability'],
  },
  {
    badge: 'C++',
    title: 'Embedded & Real-Time Software',
    color: 'green',
    text: 'Senior C++ and Python across aircraft onboard diagnostics, electron-microscopy detector software and FPGA-adjacent systems.',
    tags: ['C++17/20', 'Python', 'ARM / RTOS', 'HAL & IPC', 'gRPC', 'Conan'],
  },
  {
    badge: '🔐',
    title: 'Linux, Networking & Security',
    color: 'orange',
    text: 'Inspection proxy and adaptive firewall on Linux: TLS inspection, Kerberos/LDAP/OCSP, Netlink and nftables, Suricata and PostgreSQL integration.',
    tags: ['Linux', 'Netlink / nftables', 'TLS 1.3', 'Kerberos / LDAP'],
  },
];

const colorClasses = {
  cyan: { border: 'border-cyan-500/30 hover:border-cyan-400/50', title: 'text-cyan-400', badge: 'from-cyan-400 to-blue-500', tag: 'border-cyan-500/30 bg-cyan-500/20 text-cyan-300' },
  purple: { border: 'border-purple-500/30 hover:border-purple-400/50', title: 'text-purple-400', badge: 'from-purple-400 to-pink-500', tag: 'border-purple-500/30 bg-purple-500/20 text-purple-300' },
  green: { border: 'border-green-500/30 hover:border-green-400/50', title: 'text-green-400', badge: 'from-green-400 to-emerald-500', tag: 'border-green-500/30 bg-green-500/20 text-green-300' },
  orange: { border: 'border-orange-500/30 hover:border-orange-400/50', title: 'text-orange-400', badge: 'from-orange-400 to-yellow-500', tag: 'border-orange-500/30 bg-orange-500/20 text-orange-300' },
};

const experience = [
  {
    company: 'Resideo (Ademco)',
    via: 'CoolPeople contractor',
    role: 'Test Automation Engineer (Python, C#)',
    period: '01/2026 – 09/2026',
    summary:
      'Hardware-in-the-loop verification of a safety-certified two-stage gas furnace ignition controller (UL/CSA, ANSI Z21.20, NFPA 54), as sole owner of the verification suite and the automated bench that drives it.',
    points: [
      'Arrange/Act/Assert validation pipeline with eight independent gates, from preconditions and stimulus timing to requirement traceability.',
      'Data-driven generator turning a YAML catalogue of 270+ transitions, 38 states and 33 events into ~290 executable tests.',
      'Bench device layer with one thread per instrument on a shared monotonic clock (programmable AC source, CAN, Modbus), plus a correlated JSONL timeline for cross-device root-cause analysis.',
      'Closed a ~148-case gap where stimulus windows were never measured; found a leaked USB handle misreported as a hardware fault for months.',
      'Unattended nightly pipeline with crash recovery, Excel evidence workbooks and HTML dashboards; report generation cut from 15.7 s to 1.6 s.',
      'Built the agentic AI harness (agents, skills, policy hooks, MCP servers) used daily in delivery.',
    ],
  },
  {
    company: 'Thermo Fisher Scientific',
    via: 'Ixperta contractor',
    role: 'Software Developer (C++)',
    period: '2023 – 2024',
    summary: 'Electron-microscopy software for high-resolution detector hardware operation and image acquisition.',
    points: [
      'Server-side C++ with hardware abstraction layers and COM/MIDL inter-process communication on Windows.',
      'Embedded software for FPGA hardware over gRPC in C++, Python and Linux; C# WPF backend work.',
      'Built vscode-automation, a VS Code extension combining TICS code-quality analysis with the OpenAI API for AI-assisted remediation; ran GitHub Copilot knowledge-sharing sessions.',
    ],
  },
  {
    company: 'Honeywell',
    role: 'Software Engineer (C++)',
    period: '2022 – 2023',
    summary: 'Onboard Maintenance System that monitors aircraft condition and diagnoses issues in flight.',
    points: [
      'Architected DiagTest, a state-machine diagnostic test engine in C++ managing 15+ operational states.',
      'Job-based asynchronous test orchestration with message-queue processing and test-interference management.',
      'Python integration tests for protocols, state transitions and failure scenarios; ARM/RTOS, Flatbuffers, Conan.',
    ],
  },
  {
    company: 'Trusted Network Solutions',
    role: 'Software Engineer (C++, Linux)',
    period: '2020 – 2022',
    summary: 'Kernun Adaptive Firewall — forward proxy and network components on Linux.',
    points: [
      'HTTP/HTTPS forward proxy with TLS inspection, OCSP validation, Kerberos authentication and LDAP lookup.',
      'ipmon: C++20 Netlink daemon tracking IPv4/IPv6 changes and updating nftables rules.',
      'Integration with Suricata and nftables, log aggregation in PostgreSQL; Perl test framework for protocol and auth testing.',
    ],
  },
  {
    company: 'IBM',
    role: 'Automation Developer / IT Systems Specialist',
    summary: 'Automation application replacing manual ticketing and server-administration work (Bash, PowerShell, JavaScript); Unix/Windows production monitoring.',
    points: [],
  },
];

const openSource = [
  {
    name: 'MCP-Prompts',
    meta: '100+ ★ on GitHub',
    text: 'Model Context Protocol server for prompt templates and LLM interactions. Published to npm, Docker Hub and MCP directories (Glama, MCP Market, PulseMCP); Rust port on crates.io.',
    url: 'https://github.com/sparesparrow/mcp-prompts',
  },
  {
    name: 'rust-network-mgr',
    meta: 'Rust · crates.io',
    text: 'Reimplementation of the C++20 ipmon daemon: drives nftables rules via Netlink with atomic updates, lock-free data structures and epoll.',
    url: 'https://crates.io/crates/rust-network-mgr',
  },
  {
    name: 'mcp-project-orchestrator',
    meta: 'Python',
    text: 'Template orchestration with design-pattern recognition, project scaffolding and Mermaid diagram generation.',
    url: 'https://github.com/sparesparrow/mcp-project-orchestrator',
  },
  {
    name: 'rtp-midi',
    meta: 'Rust · Kotlin · ESP32',
    text: 'Real-time MIDI, audio and LED control: RTP-MIDI for DAWs, OSC for LED devices, Android hub with Rust NDK and an ESP32 FreeRTOS visualiser.',
    url: 'https://github.com/sparesparrow/rtp-midi',
  },
];

const caseStudies = [
  {
    id: 'hil-verification',
    href: 'case-studies/hil-verification',
    kicker: 'Resideo · safety-critical',
    title: 'HIL verification of a certified ignition controller',
    result: '~290 generated tests, an 8-gate validator and a 148 → 0 measurement gap closed on real hardware.',
  },
  {
    id: 'agentic-tooling',
    kicker: 'Agentic AI · open source',
    title: 'Agentic harness and MCP servers',
    result: 'Agents, skills and policy hooks used daily in delivery; MCP-Prompts published on npm and Docker Hub.',
  },
  {
    id: 'aircraft-diagnostics',
    kicker: 'Honeywell · aerospace',
    title: 'Aircraft onboard diagnostic test engine',
    result: 'C++ state machine with 15+ states, async job queue and test-interference management.',
  },
  {
    id: 'network-security',
    kicker: 'Kernun firewall · Linux',
    title: 'TLS-inspecting proxy and dynamic firewall',
    result: 'Forward proxy with Kerberos/LDAP/OCSP; Netlink → nftables daemon, later rewritten in Rust.',
  },
];

const cvVariants = [
  { label: 'Full CV (2026)', note: 'Complete detail, all roles and open source', file: 'Vojtech_Spacek_CV.pdf' },
  { label: 'Czech contractor', note: 'IČO, Brno on-site / hybrid / remote', file: 'Vojtech_Spacek_CV_CZ_contractor.pdf' },
  { label: 'Poland B2B', note: 'Embedded & real-time focus, remote-first', file: 'Vojtech_Spacek_CV_PL_B2B.pdf' },
  { label: 'Switzerland dossier', note: 'Personal details and references section', file: 'Vojtech_Spacek_CV_CH_dossier.pdf' },
];

const publications = {
  title: 'Articles at Stoky Svobodného přístavu',
  intro: 'Czech-language essays published as "sparesparrow" on technology, economics and individual liberty.',
  items: [
    { title: 'Následky státního školství', date: '2025-04-30', url: 'https://stoky.urza.cz/texty/nasledky-statniho-skolstvi-3160' },
    { title: 'Stát proti podnikání', date: '2025-03-25', url: 'https://stoky.urza.cz/texty/stat-proti-podnikani-3131' },
    {
      title: 'Jednejte, a bude vám sjednáno Pojednání o ekonomii',
      date: '2025-03-07',
      url: 'https://stoky.urza.cz/texty/jednejte-a-bude-vam-sjednano-pojednani-o-ekonomii-3113',
    },
    {
      title: 'Kyberkriminalita je klíčem ke státnímu dohledu nad kyberprostorem',
      date: '2024-11-01',
      url: 'https://stoky.urza.cz/texty/kyberkriminalita-je-klicem-ke-statnimu-dohledu-nad-kyberprostorem-3018',
    },
    { title: 'Nebezpečnější než CBDC', date: '2024-10-28', url: 'https://stoky.urza.cz/texty/nebezpecnejsi-nez-cbdc-2946' },
    { title: 'O svobodě slova na X', date: '2024-10-14', url: 'https://stoky.urza.cz/texty/o-svobode-slova-na-x-2943' },
  ],
  moreCta: 'View all on Stoky',
  moreUrl: 'https://stoky.urza.cz/autori/sparesparrow-937',
};
---

<CyberpunkLayout title={title}>
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900">
    <!-- Hero Section -->
    <section id="home" class="relative overflow-hidden pb-24 pt-20">
      <div class="bg-grid-pattern absolute inset-0 opacity-10"></div>
      <div class="container relative z-10 mx-auto px-6">
        <div class="text-center">
          <h1
            class="mb-6 bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-4xl font-bold text-transparent md:text-6xl lg:text-7xl"
          >
            Vojtěch Špaček
          </h1>
          <div class="mb-6 font-mono text-lg text-cyan-300 md:text-2xl">
            AI/LLM integration engineer (MCP) · Senior C++ &amp; Python
          </div>
          <div class="mx-auto mb-10 grid max-w-5xl items-center gap-8 md:grid-cols-[1fr,auto]">
            <div class="text-left md:text-left">
              <p class="mb-4 text-lg text-slate-200 md:text-xl">
                I bring agentic-AI tooling (Model Context Protocol) into safety-critical engineering workflows —
                embedded systems, hardware-in-the-loop verification, Linux and networking.
              </p>
              <p class="text-sm text-slate-400">
                Brno, Czech Republic · EU citizen · independent contractor (IČO) · on-site, hybrid or remote ·
                Czech &amp; Slovak native, English C1
              </p>
            </div>
            <figure
              class="justify-self-center rounded-xl border border-cyan-500/30 bg-slate-800/40 p-3 backdrop-blur-sm"
            >
              <img src={`${base}assets/ai-hero.svg`} alt="" class="h-24 w-auto md:h-28 lg:h-32" loading="lazy" />
            </figure>
          </div>

          <!-- Stats Grid -->
          <div class="mx-auto mb-12 grid max-w-5xl grid-cols-2 gap-4 md:grid-cols-4">
            {
              stats.map(stat => (
                <div class={`rounded-lg border ${stat.border} bg-slate-800/50 p-4 backdrop-blur-sm`}>
                  <div class={`text-2xl font-bold ${stat.color}`}>{stat.value}</div>
                  <div class="text-sm text-slate-300">{stat.label}</div>
                </div>
              ))
            }
          </div>

          <div class="flex flex-col justify-center gap-4 sm:flex-row">
            <a
              href={links.cv}
              class="rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-8 py-3 font-medium text-white transition-all duration-300 hover:from-cyan-400 hover:to-purple-400"
            >
              Download CV (PDF)
            </a>
            <a
              href={links.calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-lg border border-cyan-500/50 px-8 py-3 font-medium text-cyan-400 transition-all duration-300 hover:bg-cyan-500/10"
            >
              Schedule a call
            </a>
            <a
              href={`${base}case-studies`}
              class="rounded-lg border border-purple-500/50 px-8 py-3 font-medium text-purple-400 transition-all duration-300 hover:bg-purple-500/10"
            >
              Case studies
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Expertise -->
    <section id="features" class="py-20">
      <div class="container mx-auto px-6">
        <h2 class="mb-16 text-center text-3xl font-bold text-white md:text-4xl">Core Expertise</h2>

        <div class="grid gap-8 md:grid-cols-2">
          {
            expertise.map(item => {
              const c = colorClasses[item.color];
              return (
                <div class={`rounded-lg border ${c.border} bg-slate-800/30 p-6 backdrop-blur-sm transition-all duration-300`}>
                  <div class="mb-4 flex items-center gap-4">
                    <div
                      class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${c.badge}`}
                    >
                      <span class="text-lg font-bold text-white">{item.badge}</span>
                    </div>
                    <h3 class={`text-xl font-bold ${c.title}`}>{item.title}</h3>
                  </div>
                  <p class="mb-5 text-slate-300">{item.text}</p>
                  <div class="flex flex-wrap gap-2">
                    {item.tags.map(tag => (
                      <span class={`rounded-full border px-3 py-1 text-sm ${c.tag}`}>{tag}</span>
                    ))}
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- Case studies teaser -->
    <section id="case-studies" class="py-20">
      <div class="container mx-auto px-6">
        <h2 class="mb-4 text-center text-3xl font-bold text-white md:text-4xl">Case Studies</h2>
        <p class="mx-auto mb-12 max-w-2xl text-center text-slate-300">
          Problem, architecture and results for four pieces of work.
        </p>
        <div class="grid gap-6 md:grid-cols-2">
          {
            caseStudies.map(item => (
              <a
                href={`${base}${item.href ?? `case-studies#${item.id}`}`}
                class="group block rounded-xl border border-slate-700/50 bg-slate-800/30 p-6 transition-colors duration-300 hover:border-cyan-400/40"
              >
                <div class="mb-1 font-mono text-xs text-purple-300">{item.kicker}</div>
                <div class="mb-2 text-lg font-semibold text-cyan-300 group-hover:text-cyan-200">{item.title}</div>
                <p class="text-sm text-slate-300">{item.result}</p>
              </a>
            ))
          }
        </div>
        <div class="mt-10 text-center">
          <a
            href={`${base}case-studies`}
            class="rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-8 py-3 font-medium text-white transition-all duration-300 hover:from-cyan-400 hover:to-purple-400"
          >
            Read the case studies
          </a>
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="bg-slate-900/40 py-20">
      <div class="container mx-auto max-w-4xl px-6">
        <h2 class="mb-16 text-center text-3xl font-bold text-white md:text-4xl">Experience</h2>

        <ol class="relative border-l border-cyan-500/30">
          {
            experience.map(job => (
              <li class="mb-12 ml-6">
                <span class="absolute -left-2 mt-2 h-4 w-4 rounded-full border border-cyan-400 bg-slate-900" />
                <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                  <h3 class="text-xl font-bold text-cyan-300">
                    {job.company}
                    {job.via && <span class="text-base font-normal text-slate-400"> · {job.via}</span>}
                  </h3>
                  {job.period && <span class="font-mono text-sm text-slate-400">{job.period}</span>}
                </div>
                <div class="mb-2 font-medium text-purple-300">{job.role}</div>
                <p class="mb-3 text-slate-300">{job.summary}</p>
                {job.points.length > 0 && (
                  <ul class="list-disc space-y-1 pl-5 text-sm text-slate-400">
                    {job.points.map(point => (
                      <li>{point}</li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>

        <div class="mt-4 rounded-lg border border-slate-700/50 bg-slate-800/30 p-6">
          <h3 class="mb-2 text-lg font-bold text-white">Education &amp; training</h3>
          <ul class="space-y-1 text-sm text-slate-300">
            <li>
              Masaryk University, Faculty of Informatics — Computer Science coursework (no degree awarded):
              programming, Linux, networking.
            </li>
            <li>
              Coursera / DeepLearning.AI — Deep Learning Specialization (Andrew Ng), data analysis, prompt engineering,
              building LLM agents.
            </li>
            <li>Self-directed — design patterns and software architecture, Hack The Box.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Open Source -->
    <section id="projects" class="py-20">
      <div class="container mx-auto px-6">
        <h2 class="mb-16 text-center text-3xl font-bold text-white md:text-4xl">Open Source</h2>

        <div class="mb-16 grid gap-6 md:grid-cols-2">
          {
            openSource.map(project => (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group block rounded-xl border border-slate-700/50 bg-slate-800/30 p-6 transition-colors duration-300 hover:border-cyan-400/40"
              >
                <div class="mb-1 flex items-baseline justify-between gap-4">
                  <span class="text-lg font-semibold text-cyan-300 group-hover:text-cyan-200">{project.name}</span>
                  <span class="font-mono text-xs text-slate-400">{project.meta}</span>
                </div>
                <p class="text-sm text-slate-300">{project.text}</p>
              </a>
            ))
          }
        </div>

        <RepoGallery client:load />
      </div>
    </section>

    <!-- Publications (Stoky) -->
    <section class="bg-slate-900/40 py-20">
      <div class="container mx-auto px-6">
        <div class="mb-10 text-center">
          <h2 class="mb-4 text-3xl font-bold text-white md:text-4xl">{publications.title}</h2>
          <p class="mx-auto max-w-3xl text-slate-300">{publications.intro}</p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {
            publications.items.map(item => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                lang="cs"
                class="group block rounded-xl border border-slate-700/50 bg-slate-800/30 p-6 transition-colors duration-300 hover:border-cyan-400/40"
              >
                <div class="mb-2 text-sm text-slate-400">{item.date}</div>
                <div class="text-lg font-semibold text-cyan-300 group-hover:text-cyan-200">{item.title}</div>
              </a>
            ))
          }
        </div>

        <div class="mt-10 text-center">
          <a
            href={publications.moreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-8 py-3 font-medium text-white transition-all duration-300 hover:from-cyan-400 hover:to-purple-400"
          >
            {publications.moreCta}
          </a>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-20">
      <div class="container mx-auto max-w-4xl px-6 text-center">
        <h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">Contact</h2>
        <p class="mb-8 text-slate-300">
          Available for contract work on AI/LLM integration, safety-critical verification and embedded or Linux
          software. Brno on-site or remote.
        </p>

        <div class="mb-12 flex flex-col flex-wrap justify-center gap-4 sm:flex-row">
          <a
            href={links.email}
            class="rounded-lg bg-gradient-to-r from-cyan-500 to-purple-500 px-8 py-3 font-medium text-white transition-all duration-300 hover:from-cyan-400 hover:to-purple-400"
          >
            sparesparrow@protonmail.ch
          </a>
          <a
            href={links.calendly}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-cyan-500/50 px-8 py-3 font-medium text-cyan-400 transition-all duration-300 hover:bg-cyan-500/10"
          >
            Schedule a call
          </a>
          <a
            href={links.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-slate-600 bg-slate-800 px-8 py-3 font-medium text-white transition-all duration-300 hover:bg-slate-700"
          >
            LinkedIn
          </a>
          <a
            href={links.github}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-slate-600 bg-slate-800 px-8 py-3 font-medium text-white transition-all duration-300 hover:bg-slate-700"
          >
            GitHub
          </a>
        </div>

        <h3 class="mb-6 text-xl font-bold text-cyan-400">CV downloads</h3>
        <div class="grid gap-4 text-left sm:grid-cols-2">
          {
            cvVariants.map(variant => (
              <a
                href={`${base}cv/${variant.file}`}
                class="block rounded-lg border border-slate-700/50 bg-slate-800/30 p-4 transition-colors duration-300 hover:border-cyan-400/40"
              >
                <div class="font-semibold text-cyan-300">{variant.label} · PDF</div>
                <div class="text-sm text-slate-400">{variant.note}</div>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</CyberpunkLayout>
