---
import CyberpunkLayout from '../layouts/CyberpunkLayout.astro';
import MainLayout from '../layouts/MainLayout.astro';
export interface Props {
  title?: string;
}
const { title = 'Sparrow AI Tech' } = Astro.props;
import LanguageToggle from '../components/core/LanguageToggle.jsx';
import ThemeToggle from '../components/core/ThemeToggle.jsx';
import ThemeSelect from '../components/core/ThemeSelect.jsx';
const rawBase = import.meta.env.BASE_URL || '/sparrow-ai-tech';
const base = rawBase.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Vojtěch Špaček — AI/LLM integration engineer (Model Context Protocol) and senior C++ &amp; Python developer for safety-critical embedded systems, HIL verification, Linux and networking." />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href={`${base}/css/main.css`} />
    <meta
      name="keywords"
      content="Vojtěch Špaček, Model Context Protocol, MCP, AI/LLM integration, C++, Python, hardware-in-the-loop, embedded, Linux"
    />
    <meta name="author" content="Vojtěch Špaček" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sparesparrow.github.io/sparrow-ai-tech/" />
    <meta property="og:title" content="Vojtěch Špaček | AI/LLM Integration & Embedded Engineer" />
    <meta
      property="og:description"
      content="Vojtěch Špaček — AI/LLM integration engineer (Model Context Protocol) and senior C++ &amp; Python developer for safety-critical embedded systems, HIL verification, Linux and networking."
    />
    <meta property="og:image" content="https://sparesparrow.github.io/sparrow-ai-tech/og-image.png" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://sparesparrow.github.io/sparrow-ai-tech/" />
    <meta property="twitter:title" content="Vojtěch Špaček | AI/LLM Integration & Embedded Engineer" />
    <meta
      property="twitter:description"
      content="Vojtěch Špaček — AI/LLM integration engineer (Model Context Protocol) and senior C++ &amp; Python developer for safety-critical embedded systems, HIL verification, Linux and networking."
    />
    <meta property="twitter:image" content="https://sparesparrow.github.io/sparrow-ai-tech/og-image.png" />
  </head>
  <body>
    <nav class="nav">
      <div class="nav-container">
        <a class="nav-logo" href={`${base}/`}>sparesparrow</a>
        <div class="nav-actions" style="display:flex; align-items:center; gap:.5rem;">
          <LanguageToggle client:load />
          <ThemeToggle client:load />
          <ThemeSelect client:load />
        </div>
        <div class="nav-links">
          <a href={`${base}/`} class="nav-link">Home</a>
          <a href={`${base}/case-studies`} class="nav-link">Case Studies</a>
          <a href={`${base}/#experience`} class="nav-link">Experience</a>
          <a href={`${base}/#projects`} class="nav-link">Open Source</a>
          <a href={`${base}/#contact`} class="nav-link">Contact</a>
        </div>
      </div>
    </nav>

    <slot />

    <!-- Enhanced Footer -->
    <footer class="footer">
      <div class="container">
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem;"
        >
          <div>
            <h4 style="color: var(--color-cyber-green); margin-bottom: 1rem;">Vojtěch Špaček</h4>
            <p style="color: var(--color-cyber-text-dim); margin: 0;">
              AI/LLM integration (Model Context Protocol) for safety-critical embedded and HIL verification. Brno · remote.
            </p>
          </div>
          <div>
            <h4 style="color: var(--color-cyber-blue); margin-bottom: 1rem;">Technologies</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              <span
                style="background: rgba(57, 255, 20, 0.1); color: var(--color-cyber-green); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem;"
                >C++</span
              >
              <span
                style="background: rgba(88, 166, 255, 0.1); color: var(--color-cyber-blue); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem;"
                >Python</span
              >
              <span
                style="background: rgba(210, 168, 255, 0.1); color: var(--color-cyber-purple); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem;"
                >MCP</span
              >
              <span
                style="background: rgba(248, 81, 73, 0.1); color: var(--color-cyber-orange); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem;"
                >HIL</span
              >
              <span
                style="background: rgba(57, 255, 20, 0.1); color: var(--color-cyber-green); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.8rem;"
                >Linux</span
              >
            </div>
          </div>
          <div>
            <h4 style="color: var(--color-cyber-purple); margin-bottom: 1rem;">Useful Links</h4>
            <div style="display: flex; flex-direction: column; gap: 0.5rem;">
              <a
                href="https://github.com/sparesparrow"
                style="color: var(--color-cyber-text-dim); text-decoration: none; transition: color 0.3s ease;"
                >GitHub</a
              >
              <a
                href={`${base}/cv/Vojtech_Spacek_CV.pdf`}
                style="color: var(--color-cyber-text-dim); text-decoration: none; transition: color 0.3s ease;"
                >CV (PDF)</a
              >
              <a
                href={`${base}/case-studies`}
                style="color: var(--color-cyber-text-dim); text-decoration: none; transition: color 0.3s ease;"
                >Case Studies</a
              >
            </div>
          </div>
        </div>
        <p
          style="color: var(--color-cyber-text-dim); margin: 0; text-align: center; border-top: 1px solid var(--color-cyber-border); padding-top: 1rem;"
        >
          © 2026 Vojtěch Špaček (sparesparrow)
        </p>
      </div>
    </footer>
    <script src={`${base}/js/app.js`} defer></script>
    <elevenlabs-convai agent-id="agent_01jwpatrdff2dsns5d56n0ardm"></elevenlabs-convai>
    <script is:inline src="https://unpkg.com/@elevenlabs/convai-widget-embed" async type="text/javascript"></script>
  </body>
</html>

<style is:global>
  @import '../styles/cyberpunk.css';
  @import '../styles/main.css';
  @import '../styles/style.css';
  @import '../styles/styles.css';
  @import '../styles/global.css';
  @import '../styles/theme.css';
  @import '../styles/typography.css';
  @import '../styles/professional.css';
  @import '../styles/tech.css';
  @import '../styles/base.css';
  @import '../styles/modern.css';
  @import '../styles/minimal.css';
</style>
